# SK AI Talent Lab LLM 게이트웨이 (Azure OpenAI 호환 — /openai/deployments/{deployment}/... 경로)
LLM_GATEWAY_BASE_URL=https://skax.ai-talentlab.com
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_API_VERSION=2024-12-01-preview
LLM_CHAT_DEPLOYMENT=gpt-4.1-mini
LLM_EMBEDDING_DEPLOYMENT=text-embedding-3-small

QDRANT_URL=http://localhost:6333

# 앱 자체 운영 DB (run 레지스트리, LangGraph 체크포인트, 도메인 접속정보) — 타겟 도메인 DB와 무관, 항상 고정
APP_DB_HOST=localhost
APP_DB_PORT=5433
APP_DB_NAME=nl2sql_app
APP_DB_USER=postgres
APP_DB_PASSWORD=postgres

# domain_connections 테이블에 저장되는 DB 비밀번호를 암호화하는 키.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" 로 생성,
# 반드시 .env에만 두고 커밋하지 않는다 — 이 키가 없으면 저장된 접속정보를 복호화할 수 없다.
APP_SECRET_KEY=

# 타겟 도메인 접속정보(host/port/password 등)는 더 이상 여기서 관리하지 않는다.
# app-db의 domain_connections 테이블에 저장되며, scripts/register_domain.py로 등록/교체한다.
